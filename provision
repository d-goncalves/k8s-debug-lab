#!/usr/bin/env bash
# Bootstrap wrapper: ensures a venv with click exists, then runs the Python CLI.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$ROOT/.venv"
if [ ! -x "$VENV/bin/python" ]; then
  echo "→ first run: creating .venv and installing dependencies" >&2
  python3 -m venv "$VENV"
  "$VENV/bin/pip" install -q -r "$ROOT/requirements.txt"
fi
exec "$VENV/bin/python" "$ROOT/provision.py" "$@"
