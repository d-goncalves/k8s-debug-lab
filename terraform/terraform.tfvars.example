# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
proxmox_endpoint  = "https://proxmox.example.com:8006/"
proxmox_api_token = "user@realm!tokenid=00000000-0000-0000-0000-000000000000"
proxmox_node      = "pve"
proxmox_insecure  = true

vm_id     = 120
vm_name   = "k8s-debug-lab"
vm_cores  = 2
vm_memory = 4096
vm_disk   = 30
vm_bridge = "vmbr0"

ssh_public_key = "ssh-ed25519 AAAA... you@example.com"
vm_address = "192.168.1.60/24"
vm_gateway = "192.168.1.1"
